{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balance and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "balance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "pendingWithdrawn": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "balance"]
    },
    "Submission": {
      "title": "Submission",
      "description": "User Gmail accounts submission",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "dataContent": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Cek Admin", "Diterima", "Ditolak"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "dataContent", "status"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "User balance withdrawal request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["DANA", "GoPay"] },
        "targetNumber": { "type": "string" },
        "recipientName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Selesai", "Ditolak"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "amount", "method", "targetNumber", "status"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Platform global configuration and operational state",
      "type": "object",
      "properties": {
        "storanOpen": { "type": "boolean" },
        "pricePerSubmission": { "type": "number" },
        "minWithdrawal": { "type": "number" },
        "rules": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account documents keyed by Firebase Auth UID"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Submissions submitted by freelancers for review"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal requests submitted by freelancers"
    },
    "/settings/general": {
      "schema": "SystemSettings",
      "description": "System operational parameters and limits"
    }
  }
}

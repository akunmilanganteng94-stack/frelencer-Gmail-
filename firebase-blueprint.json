{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data including role, balance, and account state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "balance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "pendingWithdrawn": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role", "balance", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Freelancer data submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "dataContent": { "type": "string", "maxLength": 1000 },
        "rewardAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Diterima", "Ditolak"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "adminNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "dataContent", "rewardAmount", "status", "createdAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "User withdrawal request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["DANA", "GoPay"] },
        "targetNumber": { "type": "string", "maxLength": 30 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Pending", "Selesai", "Ditolak"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "method", "targetNumber", "recipientName", "status", "createdAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global operational and pricing parameters",
      "type": "object",
      "properties": {
        "storanOpen": { "type": "boolean" },
        "storanSchedule": { "type": "string", "maxLength": 200 },
        "pricePerSubmission": { "type": "number" },
        "withdrawalOpen": { "type": "boolean" },
        "minWithdrawal": { "type": "number" },
        "rules": { "type": "array" },
        "announcement": { "type": "string", "maxLength": 1000 }
      },
      "required": ["storanOpen", "pricePerSubmission", "withdrawalOpen", "minWithdrawal"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profile and balance info"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Data submissions sent by freelancers"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal requests for DANA and GoPay"
    },
    "/settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global configuration including operational schedule and rates"
    }
  }
}
